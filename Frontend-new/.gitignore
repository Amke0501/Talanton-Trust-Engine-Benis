.vercel

# TypeScript incremental build cache — regenerated on every build
*.tsbuildinfo

# Regenerated by both `next dev` and `next build`, and its contents differ between the
# two, so it flips back and forth in every diff. Nothing depends on it being committed:
# either command recreates it before type-checking.
next-env.d.ts
.next-e2e/
